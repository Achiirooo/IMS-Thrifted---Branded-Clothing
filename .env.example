# Copy this file to .env for local development.
# .env, .env.test and .env*.local are gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Development (copy to .env)
# ---------------------------------------------------------------------------
# SQLite file. The path is resolved relative to prisma/schema.prisma,
# so file:./dev.db points at prisma/dev.db
DATABASE_URL="file:./dev.db"

# iron-session cookie encryption key — must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Test environment (copy to .env.test)
# ---------------------------------------------------------------------------
# A separate database so test data never touches prisma/dev.db.
# DATABASE_URL="file:./test.db"
#
# Use a DIFFERENT secret from development. Cookies are shared across ports on
# localhost, so a distinct key keeps dev sessions invalid on the test server.
# SESSION_SECRET="replace-me-with-another-long-random-string"
