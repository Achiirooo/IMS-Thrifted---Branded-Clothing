{
  "info": {
    "name": "IMS Module 1 — Item Intake & Approval",
    "description": "Covers WBS 3.1/3.2 and Test Plan IMS-01 to IMS-08.\nRun against the test build on :3001 (NODE_ENV=test) after `npm run db:test:prepare`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "intakeItemId",
      "value": ""
    },
    {
      "key": "saleItemId",
      "value": ""
    },
    {
      "key": "pendingItemId",
      "value": ""
    },
    {
      "key": "staffId",
      "value": ""
    },
    {
      "key": "staff2Id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Authentication (setup)",
      "description": "Session + RBAC baseline.",
      "item": [
        {
          "name": "TC-05 anonymous request is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 without a session\", () => pm.response.to.have.status(401));",
                  "pm.test(\"JSON error body\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is STAFF\", () => pm.expect(pm.response.json().user.role).to.eql(\"STAFF\"));",
                  "pm.collectionVariables.set(\"staffId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Session identifies the Staff user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 with a user\", () => pm.response.to.have.status(200));",
                  "pm.test(\"username is staff1\", () => pm.expect(pm.response.json().user.username).to.eql(\"staff1\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Item intake",
      "description": "IMS-03 / IMS-04 validation rules.",
      "item": [
        {
          "name": "TC-07 required fields are enforced",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 for missing fields\", () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test(\"field errors are returned\", () => pm.expect(body.fieldErrors).to.be.an(\"object\"));",
                  "pm.test(\"name is reported\", () => pm.expect(body.fieldErrors.name).to.be.an(\"array\"));",
                  "pm.test(\"price is reported\", () => pm.expect(body.fieldErrors.price).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-08 price 0 is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"brand\": \"Test\",\n  \"category\": \"Test\",\n  \"size\": \"M\",\n  \"condition\": \"Good\",\n  \"price\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 for price 0\", () => pm.response.to.have.status(400));",
                  "pm.test(\"price message\", () => pm.expect(pm.response.json().error).to.eql(\"Price must be greater than 0\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-08 negative price is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"brand\": \"Test\",\n  \"category\": \"Test\",\n  \"size\": \"M\",\n  \"condition\": \"Good\",\n  \"price\": -50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 for negative price\", () => pm.response.to.have.status(400));",
                  "pm.test(\"price message\", () => pm.expect(pm.response.json().error).to.eql(\"Price must be greater than 0\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-08 non-numeric price is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test\",\n  \"brand\": \"Test\",\n  \"category\": \"Test\",\n  \"size\": \"M\",\n  \"condition\": \"Good\",\n  \"price\": \"abc\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 for non-numeric price\", () => pm.response.to.have.status(400));",
                  "pm.test(\"field error on price\", () => pm.expect(pm.response.json().fieldErrors.price).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-06 valid item is saved as Pending",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TEST-Intake Jacket\",\n  \"brand\": \"Levi's\",\n  \"category\": \"Test Intake\",\n  \"size\": \"M\",\n  \"condition\": \"Good\",\n  \"price\": 1299\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 created\", () => pm.response.to.have.status(201));",
                  "const item = pm.response.json().item;",
                  "pm.test(\"status starts as Pending\", () => pm.expect(item.status).to.eql(\"Pending\"));",
                  "pm.test(\"item id is returned\", () => pm.expect(item.id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"intakeItemId\", item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-06 initial status log is written",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 for the new item\", () => pm.response.to.have.status(200));",
                  "const item = pm.response.json().item;",
                  "pm.test(\"item is Pending\", () => pm.expect(item.status).to.eql(\"Pending\"));",
                  "pm.test(\"one creation log row\", () => pm.expect(item.statusLogs.length).to.eql(1));",
                  "pm.test(\"log starts at Pending\", () => pm.expect(item.statusLogs[0].newStatus).to.eql(\"Pending\"));",
                  "pm.test(\"creation has no previous status\", () => pm.expect(item.statusLogs[0].oldStatus).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-01 Staff cannot approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 for Staff\", () => pm.response.to.have.status(403));",
                  "pm.test(\"no status change was applied\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-01 Staff cannot open reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 for Staff\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Approval workflow",
      "description": "IMS-05 to IMS-08 and the status log.",
      "item": [
        {
          "name": "Login reviewer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{reviewerUsername}}\",\n  \"password\": \"{{reviewerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is REVIEWER\", () => pm.expect(pm.response.json().user.role).to.eql(\"REVIEWER\"));",
                  "pm.collectionVariables.set(\"reviewerId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-12 reject without a reason is blocked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"reject\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 without a reason\", () => pm.response.to.have.status(400));",
                  "pm.test(\"reason is required\", () => pm.expect(pm.response.json().error).to.eql(\"Give a reason for rejecting this item.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-11 reject with a reason keeps Pending",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"reject\",\n  \"reason\": \"Stained collar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 on reject\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status stays Pending\", () => pm.expect(pm.response.json().status).to.eql(\"Pending\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-11 rejection reason is stored and logged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const item = pm.response.json().item;",
                  "pm.test(\"reason is on the item\", () => pm.expect(item.rejectionReason).to.eql(\"Stained collar\"));",
                  "pm.test(\"Pending -> Pending log row\", () => {",
                  "  const log = item.statusLogs.find((row) => row.oldStatus === \"Pending\" && row.newStatus === \"Pending\");",
                  "  pm.expect(log.reason).to.eql(\"Stained collar\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-10 approve moves Pending to In Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 on approve\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status becomes In Stock\", () => pm.expect(pm.response.json().status).to.eql(\"In Stock\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-10 approval is logged and clears the reason",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const item = pm.response.json().item;",
                  "pm.test(\"status is In Stock\", () => pm.expect(item.status).to.eql(\"In Stock\"));",
                  "pm.test(\"rejection reason cleared\", () => pm.expect(item.rejectionReason).to.eql(null));",
                  "pm.test(\"three log rows in total\", () => pm.expect(item.statusLogs.length).to.eql(3));",
                  "pm.test(\"latest row is Pending -> In Stock\", () => {",
                  "  const log = item.statusLogs[0];",
                  "  pm.expect(log.oldStatus).to.eql(\"Pending\");",
                  "  pm.expect(log.newStatus).to.eql(\"In Stock\");",
                  "  pm.expect(log.changedBy.username).to.eql(\"reviewer1\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-13 second approval is a conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 for a stale decision\", () => pm.response.to.have.status(409));",
                  "pm.test(\"conflict message\", () => pm.expect(pm.response.json().error).to.include(\"already\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is ADMIN\", () => pm.expect(pm.response.json().user.role).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-02 Admin cannot approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{intakeItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 for Admin\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login reviewer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{reviewerUsername}}\",\n  \"password\": \"{{reviewerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is REVIEWER\", () => pm.expect(pm.response.json().user.role).to.eql(\"REVIEWER\"));",
                  "pm.collectionVariables.set(\"reviewerId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03 Reviewer cannot add items",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nope\",\n  \"brand\": \"Nope\",\n  \"category\": \"Nope\",\n  \"size\": \"M\",\n  \"condition\": \"Good\",\n  \"price\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 for Reviewer\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logout returns 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-04 session is gone after logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 after logout\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}