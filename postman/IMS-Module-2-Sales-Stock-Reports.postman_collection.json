              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 for Pending\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Status Guard message\", () => pm.expect(pm.response.json().error).to.include(\"Only In Stock items can be sold\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-15 sell an In Stock item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{saleItemId}}/sell"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 sold\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status becomes Sold\", () => pm.expect(pm.response.json().status).to.eql(\"Sold\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-17 double sale is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{saleItemId}}/sell"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 on the second sale\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Status Guard message\", () => pm.expect(pm.response.json().error).to.include(\"Only In Stock items can be sold\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-15 sale is logged once",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{saleItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const item = pm.response.json().item;",
                  "pm.test(\"item is Sold\", () => pm.expect(item.status).to.eql(\"Sold\"));",
                  "pm.test(\"three log rows (created, approved, sold)\", () => pm.expect(item.statusLogs.length).to.eql(3));",
                  "pm.test(\"exactly one In Stock -> Sold row\", () => {",
                  "  const sold = item.statusLogs.filter((row) => row.oldStatus === \"In Stock\" && row.newStatus === \"Sold\");",
                  "  pm.expect(sold.length).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
