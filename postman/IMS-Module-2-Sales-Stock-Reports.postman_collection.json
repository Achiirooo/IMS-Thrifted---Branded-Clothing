    {
      "name": "02 Stock & low-stock alerts",
      "description": "IMS-10.",
      "item": [
        {
          "name": "TC-19 low-stock category is flagged at 5",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 for Admin\", () => pm.response.to.have.status(200));",
                  "const low = pm.response.json().lowStock.find((row) => row.category === \"Low Stock Test\");",
                  "pm.test(\"Low Stock Test is flagged\", () => pm.expect(low).to.be.an(\"object\"));",
                  "pm.test(\"count is 5\", () => pm.expect(low.count).to.eql(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-20 healthy category is not flagged",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const healthy = body.lowStock.find((row) => row.category === \"Healthy Stock Test\");",
                  "pm.test(\"Healthy Stock Test is absent\", () => pm.expect(healthy).to.eql(undefined));",
                  "pm.test(\"threshold is 5\", () => pm.expect(body.lowStockThreshold).to.eql(5));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Inventory search",
      "description": "IMS-11 / IMS-15.",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is ADMIN\", () => pm.expect(pm.response.json().user.role).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-21 search by brand",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items?q=Nike&pageSize=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"results are returned\", () => pm.expect(body.total).to.be.above(0));",
                  "pm.test(\"every row matches the brand\", () => {",
                  "  body.items.forEach((item) => {",
                  "    const haystack = `${item.name} ${item.brand} ${item.category}`.toLowerCase();",
                  "    pm.expect(haystack).to.include(\"nike\");",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-21 filter by status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items?status=In%20Stock&pageSize=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"every row is In Stock\", () => body.items.forEach((item) => pm.expect(item.status).to.eql(\"In Stock\")));",
                  "pm.test(\"total matches the filtered set\", () => pm.expect(body.total).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-21 filter by size and condition",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items?size=M&condition=Good&pageSize=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"rows match size and condition\", () => body.items.forEach((item) => {",
                  "  pm.expect(item.size).to.eql(\"M\");",
                  "  pm.expect(item.condition).to.eql(\"Good\");",
                  "}));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-21 filter by price range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items?min=100&max=500&pageSize=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"prices stay inside the range\", () => body.items.forEach((item) => {",
                  "  pm.expect(item.price).to.be.at.least(100);",
                  "  pm.expect(item.price).to.be.at.most(500);",
                  "}));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-21 empty result",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
