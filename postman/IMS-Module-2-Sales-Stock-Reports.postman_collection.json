{
  "info": {
    "name": "IMS Module 2 — Sales, Stock, Search & Reports",
    "description": "Covers WBS 4.1/4.2 and Test Plan IMS-08 to IMS-15.\nRun against the test build on :3001 (NODE_ENV=test) after `npm run db:test:prepare`.\nCreates its own items in the Setup folder, so it does not depend on Module 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "intakeItemId",
      "value": ""
    },
    {
      "key": "saleItemId",
      "value": ""
    },
    {
      "key": "pendingItemId",
      "value": ""
    },
    {
      "key": "staffId",
      "value": ""
    },
    {
      "key": "staff2Id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Setup",
      "description": "Creates the items the sale checks need.",
      "item": [
        {
          "name": "TC-05 anonymous report access is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reports/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 without a session\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is STAFF\", () => pm.expect(pm.response.json().user.role).to.eql(\"STAFF\"));",
                  "pm.collectionVariables.set(\"staffId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an item for the sale flow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TEST-Sale Hoodie\",\n  \"brand\": \"Nike\",\n  \"category\": \"Test Sales\",\n  \"size\": \"L\",\n  \"condition\": \"Excellent\",\n  \"price\": 1800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"saleItemId\", pm.response.json().item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a Pending item that cannot be sold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TEST-Pending Tee\",\n  \"brand\": \"Puma\",\n  \"category\": \"Test Sales\",\n  \"size\": \"M\",\n  \"condition\": \"Good\",\n  \"price\": 600\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"pendingItemId\", pm.response.json().item.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login reviewer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{reviewerUsername}}\",\n  \"password\": \"{{reviewerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"role is REVIEWER\", () => pm.expect(pm.response.json().user.role).to.eql(\"REVIEWER\"));",
                  "pm.collectionVariables.set(\"reviewerId\", pm.response.json().user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve the sale item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/items/{{saleItemId}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 approved\", () => pm.response.to.have.status(200));",
                  "pm.test(\"now In Stock\", () => pm.expect(pm.response.json().status).to.eql(\"In Stock\"));"
                ]
              }
            }
          ]
        }
      ]
    },
