# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Binary assets — leave as-is, never convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.xlsx binary
*.db binary
*.db-journal binary
*.db-wal binary
*.db-shm binary
